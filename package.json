{
  "name": "musearr",
  "version": "0.1.0",
  "private": true,
  "description": "The private music intelligence companion for Plex.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint --workspaces --if-present && npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@musearr/api",
    "dev:web": "npm run dev --workspace=@musearr/web --",
    "dev:worker": "npm run dev --workspace=@musearr/worker",
    "migrate": "npm run migrate --workspace=@musearr/db",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "ghost-deps": "^0.1.6",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^5.0.0"
  }
}
